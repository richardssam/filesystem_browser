package: Filesystem Browser
author: Sam Richards
organization: ASWF
version: 1.0
requires: ''
rv: 2024
openrv: 2.0.0
optional: true

modes:
  - file: openrv_mode.py
    menu: ''
    shortcut: ''
    event: ''
    load: immediate

folders:
  - folder: filesystem_browser
    location: Python
    description: 'Filesystem Browser plugin module'

  - folder: openrv_compat
    location: Python
    description: 'xStudio compatibility shims for OpenRV port'

description: |
    <p>
    Browse the filesystem and load media files directly into OpenRV.
    Supports EXR sequences, MOV, MP4, and other formats with version
    grouping and time-based filtering.
    </p>
